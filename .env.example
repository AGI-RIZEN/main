SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
SESSION_COOKIE_SECURE=False
DATABASE_URL=sqlite:///db.sqlite3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
RSS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/,https://krebsonsecurity.com/feed/

# Optional: set these to let admins upload video files (Event Gallery, Films)
# to an S3 bucket instead of only linking to YouTube/Vimeo. Leave blank to
# keep video-file uploads disabled (admins can still paste a video link).
# The bucket must allow public GetObject via its bucket policy; this app
# never sets per-object ACLs.
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only for S3-compatible services (Cloudflare R2, DigitalOcean Spaces, MinIO)
AWS_S3_ENDPOINT_URL=
# Optional: serve videos from a CDN/custom domain instead of the raw S3 URL
AWS_S3_PUBLIC_BASE_URL=
