SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
SESSION_COOKIE_SECURE=False
DATABASE_URL=sqlite:///db.sqlite3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
RSS_FEEDS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/,https://krebsonsecurity.com/feed/

# Optional: set these (from your Cloudinary account's dashboard) to let admins
# upload video files (Event Gallery, Films) and have phishing/event/film
# images stored durably in Cloudinary instead of the local media/ folder.
# Leave blank to keep video-file uploads disabled (admins can still paste a
# video link) and images stored on local disk — fine for development, but
# local files do not survive a redeploy on most hosting platforms.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
